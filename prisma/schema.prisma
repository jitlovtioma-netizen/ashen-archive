generator client {
  provider = "prisma-client-js"
}

// Провайдер синхронизируется АВТОМАТИЧЕСКИ скриптом scripts/sync-db-provider.mjs
// (запускается из postinstall / dev / build): он читает DATABASE_URL и сам
// ставит правильный provider:
//   postgresql://… (Supabase)  → провайдер postgresql
//   file:…        (SQLite)      → провайдер sqlite
// Если задан DIRECT_URL — в postgres-режиме добавляется directUrl для CLI
// (db push / migrate мимо pooler'а). Вручную ничего править не нужно.
// Принудительно: bun run db:use-postgres / db:use-sqlite.
// Все типы — String, enums не используются (совместимо с обоими провайдерами).

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  login       String    @unique
  password    String
  displayName String
  system      String
  role        String    @default("USER")
  characterId String?
  // Бесплатный режим онлайна (Supabase Realtime): heartbeat /api/presence
  // пишет сюда время последнего визита стража. Nullable — миграция без потерь.
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  progress    Progress[]
}

// Прогресс стража — персистентный, привязан к пользователю и миру.
// Массивы хранятся JSON-строками (SQLite не поддерживает списки).
model Progress {
  id              String   @id @default(cuid())
  userId          String
  system          String
  achievements    String   @default("[]")
  shards          String   @default("[]")
  unlockedIds     String   @default("[]")
  revealedSecrets String   @default("[]")
  solvedRiddles   String   @default("[]")
  konamiUnlocked  Boolean  @default(false)
  secretRevealed  Boolean  @default(false)
  gaze            Int      @default(7)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, system])
  @@index([userId])
}

model Faction {
  id          String       @id @default(cuid())
  name        String
  system      String
  sigil       String
  description String
  sortOrder   Int          @default(0)
  isCorrupted Boolean      @default(false)
  userModified Boolean     @default(false)
  createdAt   DateTime     @default(now())
  npcs        Character[]
}

model Character {
  id             String   @id @default(cuid())
  name           String
  title          String
  system         String
  category       String
  race           String
  description    String
  sigil          String
  mapX           Int      @default(0)
  mapY           Int      @default(0)
  isLocked       Boolean  @default(false)
  isCorrupted    Boolean  @default(false)
  secretFragment String?
  shardWord      String?
  kind           String   @default("HERO")
  factionId      String?
  faction        Faction? @relation(fields: [factionId], references: [id])
  imageUrl       String?
  status         String   @default("ALIVE")
  // Цвет досье (violet/blue/green/amber/red/cyan/pink); null — стандартное
  themeColor     String?
  // Запись правилась в Мастерской/владельцем — seed её больше не трогает
  userModified   Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Lore {
  id             String   @id @default(cuid())
  title          String
  category       String
  system         String
  description    String
  sigil          String
  mapX           Int      @default(0)
  mapY           Int      @default(0)
  isLocked       Boolean  @default(false)
  isCorrupted    Boolean  @default(false)
  secretFragment String?
  shardWord      String?
  folder         String?
  imageUrl       String?
  sortOrder      Int      @default(0)
  status         String   @default("ALIVE")
  friendship     Int?
  themeColor     String?
  userModified   Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Location {
  id             String   @id @default(cuid())
  name           String
  type           String
  system         String
  description    String
  sigil          String
  mapX           Int      @default(0)
  mapY           Int      @default(0)
  isLocked       Boolean  @default(false)
  isCorrupted    Boolean  @default(false)
  secretFragment String?
  shardWord      String?
  themeColor     String?
  userModified   Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// Загадки-врата: привязываются к записи по имени (герой, лор, локация).
// Если для имени записи есть загадка — досье откроется только после верного
// ответа. Ответы проверяются на сервере (клиент не видит список valid).
model Riddle {
  id           String   @id @default(cuid())
  recordName   String
  sigil        String   @default("🌑")
  title        String
  subtitle     String?
  riddle       String
  valid        String   @default("[]")
  hint         String?
  system       String?
  userModified Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Achievement {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String
  sigil          String
  secretFragment String?
  system         String?
  userModified   Boolean  @default(false)
  createdAt      DateTime @default(now())
}
