# ============================================================================
# .env.example — скопируй в .env и заполни своими значениями из Supabase.
# .env НИКОГДА не коммитить в git (он в .gitignore).
# ============================================================================

# ─── БАЗА ДАННЫХ (Supabase PostgreSQL) ───
# Dashboard → Project Settings → Database → Connection string

# Для приложения (Connection pooling, порт 6543) — используется в рантайме
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Для миграций (Direct connection, порт 5432) — используется только prisma db:push / migrate
DIRECT_URL="postgresql://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── SUPABASE STORAGE (картинки) ───
# Dashboard → Project Settings → API

# Публичный URL проекта (виден клиенту)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Service Role Key — ПОЛНЫЙ доступ, обходит RLS. ТОЛЬКО server-side!
# Dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# ─── ПРИМЕР ЗАПОЛНЕННЫХ ЗНАЧЕНИЙ (для понимания формата) ───
# DATABASE_URL="postgresql://postgres.abc123:MySecretPass@aws-0-fra1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:MySecretPass@db.abc123.supabase.co:5432/postgres"
# NEXT_PUBLIC_SUPABASE_URL="https://abc123.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
